# Server shell environment for prototype/run_demo.py --mode gemini.
# Example only: the runner does not load this file. Never put a key in browser code.
GEMINI_API_KEY=
# LLM_API_KEY=  # fallback only when GEMINI_API_KEY is empty
# Model defaults to gemini-3.5-flash-lite; use --model for an explicit override.
# RATE_CARD_FILE=/absolute/path/to/reviewed-company-rates.json
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0
LLM_READ_TIMEOUT_SEC=50
LLM_CONNECT_TIMEOUT_SEC=5
