AGENT_MODE=fixture
AGENT2_MODE=fixture
AGENT2_STYLE=agent
AGENT2_USE_HINTS=true
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
# Agent 3 테스트 화면의 Gemini 모드에서 사용할 API 키 (서버 환경변수로 내보내기).
# 기존 .env에 이 항목을 추가하고 본인의 키를 입력하세요.
GEMINI_API_KEY=
# prototype/run_demo.py --mode gemini 는 .env를 자동으로 읽지 않습니다.
# --lab 화면의 Gemini 모드는 서버에서 .env 키를 직접 읽습니다.
# 서버 실행 전 셸에서 환경변수로 내보내야 하며 기본 실행은 fake 모드입니다.
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_READ_TIMEOUT_SEC=50
LLM_CONNECT_TIMEOUT_SEC=5
LLM_BASE_URL=
LLM_LOCAL_JSON_MODE=prompt
LLM_FAKE_RESPONSES=
AWS_REGION=ap-northeast-2
EMBED_PROVIDER=none
EMBED_MODEL=
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_DIM=1024
RETRIEVAL_MODE=hybrid
DATABASE_URL=
# Optional supplied JSON file. Never commit actual company rate cards.
# RATE_CARD_FILE=/absolute/path/to/rate_cards.json
STAGE_TIMEOUT_SEC=60
TOOL_MAX_RETRIES=2
