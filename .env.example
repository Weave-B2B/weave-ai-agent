AGENT_MODE=fixture
AGENT1_PROMPT_VERSION=a1-draft-v1
AGENT2_MODE=fixture
AGENT2_STYLE=agent
AGENT2_USE_HINTS=true
LLM_PROVIDER=fake
LLM_MODEL=
# Gemini와 GPT는 별도의 API 키를 사용합니다. 실제 키는 .env에만 저장하세요.
# --lab 테스트 화면의 모델 옵션에서 Gemini API를 선택해 이 키를 사용할 수 있습니다.
GEMINI_API_KEY=
LLM_API_KEY=
# --lab은 서버 환경변수 또는 .env의 키를 사용합니다.
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_READ_TIMEOUT_SEC=50
LLM_CONNECT_TIMEOUT_SEC=5
LLM_BASE_URL=
LLM_LOCAL_JSON_MODE=prompt
LLM_FAKE_RESPONSES=
AWS_REGION=ap-northeast-2
EMBED_PROVIDER=none
EMBED_MODEL=
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_DIM=1024
RETRIEVAL_MODE=hybrid
# local(JSON 파일) 또는 pgvector(weave-infra vector-db). pgvector는 python -m app.kb.build_index --store pgvector --migrate 먼저
VECTOR_STORE=local
VECTOR_DB_URL=
# 문서 색인(python -m app.indexing.run). 로컬 LocalStack이면 S3_ENDPOINT=http://localhost:4566
S3_ENDPOINT=
S3_SOURCE_BUCKET=weave-dev-files
S3_RESULT_BUCKET=weave-dev-files
DATABASE_URL=
# Optional supplied JSON file. Never commit actual company rate cards.
# RATE_CARD_FILE=/absolute/path/to/rate_cards.json
STAGE_TIMEOUT_SEC=60
TOOL_MAX_RETRIES=2
