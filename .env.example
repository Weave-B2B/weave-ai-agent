# --------------------
# Agent 실행 설정
# --------------------
AGENT_MODE=fixture
AGENT1_PROMPT_VERSION=a1-draft-v1
AGENT2_MODE=fixture
AGENT2_STYLE=agent
AGENT2_USE_HINTS=true

# --------------------
# LLM 공통 설정
# --------------------
LLM_PROVIDER=fake
LLM_MODEL=
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_READ_TIMEOUT_SEC=50
LLM_CONNECT_TIMEOUT_SEC=5

# --------------------
# 로컬모델: Ollama 설정
# --------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_READ_TIMEOUT_SEC=300
OLLAMA_CONNECT_TIMEOUT_SEC=10
OLLAMA_NUM_PREDICT=2048
OLLAMA_KEEP_ALIVE=30m

# --------------------
# 상용APi: OpenAI / Gemini 설정
# --------------------
# Gemini와 GPT는 별도의 API 키를 사용합니다. 실제 키는 .env에만 저장하세요.
LLM_API_KEY=
GEMINI_API_KEY=
LLM_BASE_URL=
LLM_LOCAL_JSON_MODE=prompt
LLM_FAKE_RESPONSES=

# --------------------
# 클라우드: AWS Bedrock 설정
# --------------------
AWS_REGION=ap-northeast-2

# --------------------
# Embedding 설정
# --------------------
EMBED_PROVIDER=none
EMBED_MODEL=
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_DIM=1024
RETRIEVAL_MODE=hybrid

# --------------------
# Vector Store 설정
# --------------------
# local(JSON 파일) 또는 pgvector(weave-infra vector-db)
# pgvector 사용 전: python -m app.kb.build_index --store pgvector --migrate
VECTOR_STORE=local
VECTOR_DB_URL=

# --------------------
# 문서 색인 설정
# --------------------
# LocalStack 사용 시: S3_ENDPOINT=http://localhost:4566
S3_ENDPOINT=
S3_SOURCE_BUCKET=weave-dev-files
S3_RESULT_BUCKET=weave-dev-files

# --------------------
# 데이터베이스 / 워크플로 설정
# --------------------
DATABASE_URL=
# Optional supplied JSON file. Never commit actual company rate cards.
# RATE_CARD_FILE=/absolute/path/to/rate_cards.json
STAGE_TIMEOUT_SEC=60
TOOL_MAX_RETRIES=2

# 공통 Run 기반 총괄 연결(추가 Backend 계약 지원 확인 후에만 활성화)
# 기존 프로토타입 실행과 /api/v2/runs/{run_id}/orchestrations 경로는 자동 전환되지 않습니다.
BACKEND_COORDINATION_ENABLED=false
# BACKEND_BASE_URL=http://localhost:8080
# BACKEND_INTERNAL_TOKEN=서버에서_발급한_내부_토큰
