# --------------------
# Agent 실행 설정
# --------------------
AGENT_MODE=llm
AGENT1_MODE=llm
AGENT1_PROMPT_VERSION=a1-draft-v1
# Agent2 평가 비교용 옵션은 기본값을 쓰므로 생략: AGENT2_STYLE=agent(workflow는 비교용), AGENT2_USE_HINTS=true

# --------------------
# LLM 공통 설정
# --------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_READ_TIMEOUT_SEC=180
LLM_CONNECT_TIMEOUT_SEC=5

# --------------------
# 로컬모델: Ollama 설정
# --------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_READ_TIMEOUT_SEC=300
OLLAMA_CONNECT_TIMEOUT_SEC=10
OLLAMA_NUM_PREDICT=2048
OLLAMA_KEEP_ALIVE=30m

# --------------------
# 상용APi: OpenAI / Gemini 설정
# --------------------
# Gemini와 GPT는 별도의 API 키를 사용합니다. 실제 키는 .env에만 저장하세요.
LLM_API_KEY=
GEMINI_API_KEY=
LLM_BASE_URL=
LLM_LOCAL_JSON_MODE=prompt
LLM_FAKE_RESPONSES=

# --------------------
# 클라우드: AWS Bedrock 설정
# --------------------
AWS_REGION=ap-northeast-2

# --------------------
# Embedding 설정
# --------------------
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
# 비우면 LLM_API_KEY를 쓴다 (openai)
EMBED_API_KEY=
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_DIM=1024
# hybrid: 어휘+벡터 검색 결합(RRF) · vector · lexical
RETRIEVAL_MODE=hybrid

# --------------------
# Vector Store 설정
# --------------------
# local(JSON 파일) 또는 pgvector(weave-infra vector-db)
# pgvector 사용 전: python -m app.kb.build_index --store pgvector --migrate
VECTOR_STORE=pgvector
# weave-infra 로컬 vector-db 기본값. 배포에서는 Secrets Manager 값으로 주입된다
VECTOR_DB_URL=postgresql://weave:weave@localhost:5433/weave_vector

# --------------------
# 문서 색인 설정
# --------------------
# 로컬은 weave-infra LocalStack. 키는 아무 값(test)이면 된다
# 배포에서는 S3_ENDPOINT·키를 비우고 Pod IAM 역할로 접근한다
S3_ENDPOINT=http://localhost:4566
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_SOURCE_BUCKET=weave-dev-files
S3_RESULT_BUCKET=weave-dev-files

# --------------------
# 데이터베이스 / 워크플로 설정
# --------------------
DATABASE_URL=
# Optional supplied JSON file. Never commit actual company rate cards.
# RATE_CARD_FILE=/absolute/path/to/rate_cards.json
STAGE_TIMEOUT_SEC=60
TOOL_MAX_RETRIES=2

# 공통 Run 기반 총괄 연결(추가 Backend 계약 지원 확인 후에만 활성화)
# 기존 프로토타입 실행과 /api/v2/runs/{run_id}/orchestrations 경로는 자동 전환되지 않습니다.
BACKEND_COORDINATION_ENABLED=false
BACKEND_BASE_URL=http://localhost:8080
# 백엔드 INTERNAL_SERVICE_TOKEN과 같은 값 (색인·범위 분석 요청 확인과 결과 전달에 쓴다). 비어 있으면 백엔드 요청을 모두 거부한다
BACKEND_INTERNAL_TOKEN=
# 기준선 문서·청크 출처. local: data/kb 샘플 · backend: 백엔드에 업로드·색인한 실제 문서 (BACKEND_BASE_URL·토큰 필요)
KB_SOURCE=backend
