# --------------------
# Agent 실행 설정
# --------------------
AGENT_MODE=llm
AGENT1_PROMPT_VERSION=a1-draft-v3
# Agent2 평가 비교용 옵션은 기본값을 쓰므로 생략: AGENT2_STYLE=agent(workflow는 비교용), AGENT2_USE_HINTS=true

# --------------------
# LLM 공통 설정
# --------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_READ_TIMEOUT_SEC=180
LLM_CONNECT_TIMEOUT_SEC=5

# --------------------
# 로컬모델: Ollama 설정 (배포 미사용)
# --------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_READ_TIMEOUT_SEC=300
OLLAMA_CONNECT_TIMEOUT_SEC=10
OLLAMA_NUM_PREDICT=2048
OLLAMA_KEEP_ALIVE=30m

# --------------------
# 상용APi: OpenAI / Gemini 설정
# --------------------
# Gemini와 GPT는 별도의 API 키를 사용합니다. 실제 키는 .env에만 저장하세요.
LLM_API_KEY= #팀 공유 API key 입력
GEMINI_API_KEY=
LLM_BASE_URL=
LLM_LOCAL_JSON_MODE=prompt
LLM_FAKE_RESPONSES=

# --------------------
# 클라우드: AWS Bedrock 설정
# --------------------
AWS_REGION=ap-northeast-2

# --------------------
# Embedding 설정
# --------------------
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
# 비우면 LLM_API_KEY를 쓴다 (openai)
EMBED_API_KEY=
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_DIM=1024
# hybrid: 어휘+벡터 검색 결합(RRF) · vector · lexical
RETRIEVAL_MODE=hybrid

# --------------------
# Vector Store 설정
# --------------------
# local(JSON 파일) 또는 pgvector(weave-infra vector-db)
# pgvector 사용 전: python -m app.kb.build_index --store pgvector --migrate
VECTOR_STORE=pgvector
# weave-infra 로컬 vector-db 기본값. 배포에서는 Secrets Manager 값으로 주입된다
VECTOR_DB_URL=postgresql://weave:weave@localhost:5433/weave_vector

# PDF 파서. r2(기본): docling + 품질 낮은 페이지 이미지 전사 + 구조 청킹. legacy: 기존 pdftotext 파서(되돌릴 때)
PDF_PARSER=r2
# 전사 모델: bedrock(기본, Claude Haiku 4.5 global 프로필 — AWS 자격 증명 사용) 또는 openai(gpt-6-luna, 아래 키 필요)
PDF_R2_TRANSCRIBE_PROVIDER=bedrock
PDF_R2_TRANSCRIBE_MODEL=
PDF_R2_OPENAI_API_KEY=

# --------------------
# 문서 색인 설정 (로컬 LocalStack S3)
# --------------------
# 로컬은 weave-infra LocalStack. 키는 아무 값(test)이면 된다
# 배포에서는 S3_ENDPOINT·키를 비우고 Pod IAM 역할로 접근한다
S3_ENDPOINT=http://localhost:4566
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_SOURCE_BUCKET=weave-dev-files
S3_RESULT_BUCKET=weave-dev-files

# --------------------
# 백엔드 ↔ AI 비동기 연동 (SQS, 로컬 LocalStack)
# --------------------
# sqs : 결과를 결과 큐로 보내고, 요청은 워커(python -m app.worker)가 요청 큐에서 받는다 (로컬 기본, dev 배포와 같음)
#       API 서버와 워커를 함께 띄운다. 백엔드도 SQS 방식(SQS_ENABLED=true, local 프로필 기본)이어야 한다
# http: 결과를 백엔드 내부 API로 바로 보낸다 (워커·LocalStack 없이 개발할 때. 백엔드도 SQS_ENABLED=false로 맞춘다)
# 로컬 큐는 weave-infra LocalStack이 만든다. 키는 S3_ACCESS_KEY_ID·S3_SECRET_ACCESS_KEY를 같이 쓴다
# 배포에서는 SQS_ENDPOINT를 비우고 Pod IAM 역할로 접근하며, 큐 URL은 AWS 큐 주소로 바꾼다
RESULT_TRANSPORT=sqs
SQS_ENDPOINT=http://localhost:4566
SQS_INDEX_REQUEST_URL=http://localhost:4566/000000000000/weave-dev-index-request
SQS_INDEX_RESULT_URL=http://localhost:4566/000000000000/weave-dev-index-result
SQS_ANALYSIS_REQUEST_URL=http://localhost:4566/000000000000/weave-dev-analysis-request
SQS_ANALYSIS_RESULT_URL=http://localhost:4566/000000000000/weave-dev-analysis-result
# 워커가 받을 큐(index,analysis)와 동시에 처리할 메시지 수
WORKER_QUEUES=index,analysis
WORKER_CONCURRENCY=2

# --------------------
# 데이터베이스 Backend 연결 설정
# --------------------
BACKEND_BASE_URL=http://localhost:8080
# 백엔드 INTERNAL_SERVICE_TOKEN과 같은 값 (색인·범위 분석 요청 확인과 결과 전달에 쓴다).
# 값은 weave-backend/src/main/resources/application-secret.yml의 INTERNAL_SERVICE_TOKEN을 복사해 .env에만 넣는다.
BACKEND_INTERNAL_TOKEN=
# 공통 Run 기반 총괄 연결(추가 Backend 계약 지원 확인 후에만 활성화)
# 기존 프로토타입 실행과 /api/v2/runs/{run_id}/orchestrations 경로는 자동 전환되지 않습니다.
BACKEND_COORDINATION_ENABLED=false
KB_SOURCE=backend

# --------------------
# 워크플로 설정
# --------------------
STAGE_TIMEOUT_SEC=60
TOOL_MAX_RETRIES=2

# 계산식 v1 공식 계산 API. 공식 연결에서는 백엔드의 확정 정책·경비 검증을 사용합니다.
BACKEND_CALCULATION_PATH=/internal/v1/estimates/calculations
# backend가 기본. fixture는 저장된 합성 예시만 재생하며 실제 UUID 계산은 항상 backend를 사용합니다.
CALCULATION_MODE=backend
# false는 로컬 합성 시연용입니다. 백엔드 UUID 단가표는 이 값과 관계없이 확정을 요구합니다.
CALC_REQUIRE_CONFIRMED_POLICY=false

# 기존 /prototype/#/requests → 엑셀·단가표 연결 분석 (PROTOTYPE_LAB=1, Backend local 전용)
# 실제 DB의 개발 계정을 한 번 설정. ID/권한 기본값 없음. 내부 토큰과 다름.
PROTOTYPE_BACKEND_COMPANY_ID=
PROTOTYPE_BACKEND_MEMBER_ID=
PROTOTYPE_BACKEND_MEMBER_ROLE=
PROTOTYPE_BACKEND_ACTOR_LABEL=로컬 개발 계정
